{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looprig.dev/sessionwire/v1/create_request.schema.json",
  "title": "CreateRequest",
  "description": "Retry-safe durable create command. session_id and command_id are client-generated opaque V1 identities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command_id", "session_id", "agent_id"],
  "properties": {
    "version": {"const": 1},
    "command_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "agent_id": {"$ref": "#/$defs/id"},
    "blocks": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "description": "Opaque UTF-8 identity; Core enforces the 256-byte limit."}
  }
}
